<Project Sdk="Microsoft.NET.Sdk">

  <!-- ====================================================================
       No path to edit. The build auto-discovers your Nuclear Option install
       (via Steam) and self-caches the BepInEx reference DLLs under .deps\.
       See build\locate-game.ps1.

       Overrides (only if auto-discovery can't find the game):
         * env var:   NUCLEAR_OPTION_PATH=<folder with NuclearOption.exe>
         * property:  dotnet build /p:GamePath="<folder with NuclearOption.exe>"
       ==================================================================== -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''"></GamePath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NuclearOption-MouseAim</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Game/Unity/BepInEx assemblies already live in the game folder; don't copy them. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Resolve <game> + BepInEx core reference dir, then declare the game/Unity/BepInEx
       references. Runs before RAR so these references are resolved and compiled against. -->
  <Target Name="LocateGame" BeforeTargets="BeforeResolveReferences">
    <!-- ConsoleToMSBuild folds the script's stderr diagnostics into ConsoleOutput, so capture
         every line and keep only the result line (the one line containing the '|' separator;
         paths never contain '|'). -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\locate-game.ps1&quot; -GamePath &quot;$(GamePath)&quot;"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" ItemName="LocateLines" />
      <Output TaskParameter="ExitCode" PropertyName="LocateExit" />
    </Exec>

    <Error Condition="'$(LocateExit)' != '0'"
           Text="locate-game.ps1 failed (exit $(LocateExit)). Set NUCLEAR_OPTION_PATH or pass /p:GamePath=&quot;&lt;game folder&gt;&quot;. See the [locate-game] messages above." />

    <ItemGroup>
      <LocateResultLine Include="@(LocateLines)"
                        Condition="$([MSBuild]::ValueOrDefault('%(Identity)', '').Contains('|'))" />
    </ItemGroup>

    <PropertyGroup>
      <LocateResult>@(LocateResultLine)</LocateResult>
      <GamePath>$(LocateResult.Split('|')[0])</GamePath>
      <BepInExCore>$(LocateResult.Split('|')[1])</BepInExCore>
      <GameManaged>$(GamePath)\NuclearOption_Data\Managed</GameManaged>
    </PropertyGroup>

    <Error Condition="'$(GamePath)' == '' or '$(BepInExCore)' == ''"
           Text="locate-game.ps1 returned no usable path (result line: '$(LocateResult)')." />

    <ItemGroup>
      <Reference Include="BepInEx">
        <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- HarmonyX — ships with BepInEx 5 in BepInEx\core. -->
      <Reference Include="0Harmony">
        <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Assembly-CSharp">
        <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine">
        <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.CoreModule">
        <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- OnGUI overlay (step 2) -->
      <Reference Include="UnityEngine.IMGUIModule">
        <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- FlightHud.virtualJoystickPos is a UnityEngine.UI.Image (hide it on engage, step 3) -->
      <Reference Include="UnityEngine.UI">
        <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- Rigidbody / gForce (optional HUD telemetry) -->
      <Reference Include="UnityEngine.PhysicsModule">
        <HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- UnityEngine.Input (legacy "Mouse X/Y" axes) for high-res raw mouse delta -->
      <Reference Include="UnityEngine.InputLegacyModule">
        <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- Rewired: reading the game's "Pan View"/"Tilt View"/"Pitch"/"Roll"/"Yaw" axes (step 2+) -->
      <Reference Include="Rewired_Core">
        <HintPath>$(GameManaged)\Rewired_Core.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- Aircraft/Player derive from Mirage's NetworkBehaviour. -->
      <Reference Include="Mirage">
        <HintPath>$(GameManaged)\Mirage.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
